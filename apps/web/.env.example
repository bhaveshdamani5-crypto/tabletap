# Copy to .env.local and fill in. NEVER commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only; bypasses RLS
TABLETAP_RESTAURANT_SLUG=brew-moon    # optional; selects the cafe opened by run.bat
CRON_SECRET=                          # 16+ random chars; protects /api/cron/*

# DEV ONLY: fake payment so you can test the kitchen without a gateway. Ignored in production builds.
DEV_SIMULATE_PAYMENT=true
NEXT_PUBLIC_DEV_SIMULATE_PAYMENT=true

# Razorpay (Dashboard > Account & Settings > API Keys). Use TEST mode keys while building.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # shown once; server only
RAZORPAY_WEBHOOK_SECRET=              # you choose it when creating the webhook; server only
